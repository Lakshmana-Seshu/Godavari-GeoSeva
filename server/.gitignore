# Dependencies
node_modules/

# Sensitive Environment Configurations
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Runtime Uploads & Generated Media
uploads/*
!uploads/.gitkeep

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Cache & Temporary Files
.cache/
*.tmp
*.temp

# Editor & OS Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~


# Godavari GeoSeva 2027 Client Environment Variables

# Google Maps Platform JavaScript API Key
# Obtain from Google Cloud Console with Maps JavaScript API enabled
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key_here

# Backend API Base URL (defaults to proxy /api/v1 in Vite development)
VITE_API_BASE_URL=http://localhost:5000/api/v1

